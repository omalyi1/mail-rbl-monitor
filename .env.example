APP_ENV=dev
APP_LOG_LEVEL=INFO

MAIL_RBL_MONITOR_TARGET_IPS=
# Optional per-target hostnames for alert text: ip=hostname,ip=hostname
MAIL_RBL_MONITOR_TARGET_HOSTS=
MAIL_RBL_MONITOR_DNSBL_PROVIDERS=zen.spamhaus.org,b.barracudacentral.org,bl.spamcop.net

MAIL_RBL_MONITOR_ENABLE_TELEGRAM=false
MAIL_RBL_MONITOR_TELEGRAM_BOT_TOKEN=
MAIL_RBL_MONITOR_TELEGRAM_CHAT_ID=

MAIL_RBL_MONITOR_ENABLE_DISCORD=false
MAIL_RBL_MONITOR_DISCORD_WEBHOOK_URL=

MAIL_RBL_MONITOR_HOST_LABEL=
MAIL_RBL_MONITOR_INCLUDE_HOSTNAME_IN_ALERTS=true
MAIL_RBL_MONITOR_INCLUDE_CHECKED_AT_IN_ALERTS=true
MAIL_RBL_MONITOR_ALERT_TIMEZONE=Europe/Kyiv

MAIL_RBL_MONITOR_TIMEOUT_SECONDS=5
MAIL_RBL_MONITOR_DRY_RUN=true
